<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- Initial Setup Block (Run Once On Start) -->
  <block type="trade_definition" id="trade_def" x="0" y="0">
    <statement name="INITIALIZATION">
      <!-- Set your manual base digits here -->
      <block type="variables_set" id="set_lowest_digit">
        <field name="VAR">Lowest_Digit</field>
        <value name="VALUE">
          <block type="math_number" id="manual_lowest_val">
            <field name="NUM">0</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="set_second_lowest_digit">
            <field name="VAR">Second_Lowest_Digit</field>
            <value name="VALUE">
              <block type="math_number" id="manual_second_lowest_val">
                <field name="NUM">2</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="init_state">
                <field name="VAR">State</field>
                <value name="VALUE">
                  <block type="math_number" id="num_init_zero">
                    <field name="NUM">0</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_select">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_definition_tradetype" id="type_select">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype" id="contract_select">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="interval_select">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restart_select">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartlasttrade" id="restart_last">
                            <next>
                              <block type="trade_definition_parameter" id="params">
                                <statement name="PARAMS">
                                  <block type="trade_definition_amount" id="amount">
                                    <value name="AMOUNT">
                                      <shadow type="math_number" id="stake_val">
                                        <field name="NUM">1</field>
                                      </shadow>
                                    </value>
                                    <next>
                                      <block type="trade_definition_duration" id="duration">
                                        <field name="UNIT_LIST">t</field>
                                        <value name="DURATION">
                                          <shadow type="math_number" id="duration_val">
                                            <field name="NUM">1</field>
                                          </shadow>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </statement>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <!-- Purchase Logic Block -->
  <block type="before_purchase" id="before_purchase_block" x="0" y="650">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="variables_set" id="set_current">
        <field name="VAR">Current_Digit</field>
        <value name="VALUE">
          <block type="last_digit" id="get_last_digit"></block>
        </value>
        <next>
          <block type="controls_if" id="state_check">
            <mutation elseif="2"></mutation>
            
            <!-- STATE 0: Check if Current Digit matches manual Lowest or Second Lowest (and is EVEN) -->
            <value name="IF0">
              <block type="logic_compare" id="is_state_0">
                <field name="OP">EQ</field>
                <value name="A">
                  <block type="variables_get" id="get_state_0">
                    <field name="VAR">State</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number" id="num_0">
                    <field name="NUM">0</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="controls_if" id="check_manual_digits">
                <value name="IF0">
                  <block type="logic_operation" id="match_digit_and_even" inline="false">
                    <field name="OP">AND</field>
                    <!-- Check if current digit equals Lowest_Digit OR Second_Lowest_Digit -->
                    <value name="A">
                      <block type="logic_operation" id="match_manual_digits" inline="false">
                        <field name="OP">OR</field>
                        <value name="A">
                          <block type="logic_compare" id="eq_lowest">
                            <field name="OP">EQ</field>
                            <value name="A">
                              <block type="variables_get" id="get_cur_digit_a">
                                <field name="VAR">Current_Digit</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="variables_get" id="get_lowest_var">
                                <field name="VAR">Lowest_Digit</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="logic_compare" id="eq_second_lowest">
                            <field name="OP">EQ</field>
                            <value name="A">
                              <block type="variables_get" id="get_cur_digit_b">
                                <field name="VAR">Current_Digit</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="variables_get" id="get_second_lowest_var">
                                <field name="VAR">Second_Lowest_Digit</field>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                    <!-- Check if current digit is EVEN (Current_Digit % 2 == 0) -->
                    <value name="B">
                      <block type="logic_compare" id="is_even_base">
                        <field name="OP">EQ</field>
                        <value name="A">
                          <block type="math_modulo" id="mod_base">
                            <value name="DIVIDEND">
                              <block type="variables_get" id="get_cur_digit_c">
                                <field name="VAR">Current_Digit</field>
                              </block>
                            </value>
                            <value name="DIVISOR">
                              <block type="math_number" id="num_mod_2">
                                <field name="NUM">2</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="num_zero">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <!-- Match found! Advance to State 1 -->
                  <block type="variables_set" id="set_state_1">
                    <field name="VAR">State</field>
                    <value name="VALUE">
                      <block type="math_number" id="num_1">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                  </block>
                </statement>
              </block>
            </statement>

            <!-- STATE 1: Confirm Even Streak (Requires at least 1 subsequent EVEN digit) -->
            <value name="IF1">
              <block type="logic_compare" id="is_state_1">
                <field name="OP">EQ</field>
                <value name="A">
                  <block type="variables_get" id="get_state_1">
                    <field name="VAR">State</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number" id="num_state_1">
                    <field name="NUM">1</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO1">
              <block type="controls_if" id="check_streak_digit" ifelse="true">
                <value name="IF0">
                  <block type="logic_compare" id="is_even_streak">
                    <field name="OP">EQ</field>
                    <value name="A">
                      <block type="math_modulo" id="mod_streak">
                        <value name="DIVIDEND">
                          <block type="variables_get" id="get_cur_digit_d">
                            <field name="VAR">Current_Digit</field>
                          </block>
                        </value>
                        <value name="DIVISOR">
                          <block type="math_number" id="num_mod_2_b">
                            <field name="NUM">2</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="num_zero_b">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <!-- Streak confirmed! Advance to State 2 -->
                  <block type="variables_set" id="set_state_2">
                    <field name="VAR">State</field>
                    <value name="VALUE">
                      <block type="math_number" id="num_val_2">
                        <field name="NUM">2</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <statement name="ELSE">
                  <!-- Reset if an odd digit appears before streak forms -->
                  <block type="variables_set" id="reset_state_0">
                    <field name="VAR">State</field>
                    <value name="VALUE">
                      <block type="math_number" id="num_val_0">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                  </block>
                </statement>
              </block>
            </statement>

            <!-- STATE 2: Streak Active -> Purchase ODD on first ODD digit -->
            <value name="IF2">
              <block type="logic_compare" id="is_state_2">
                <field name="OP">EQ</field>
                <value name="A">
                  <block type="variables_get" id="get_state_2">
                    <field name="VAR">State</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number" id="num_state_2">
                    <field name="NUM">2</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO2">
              <block type="controls_if" id="check_odd_trigger">
                <value name="IF0">
                  <block type="logic_compare" id="is_odd_trigger">
                    <field name="OP">NEQ</field>
                    <value name="A">
                      <block type="math_modulo" id="mod_trigger">
                        <value name="DIVIDEND">
                          <block type="variables_get" id="get_cur_digit_e">
                            <field name="VAR">Current_Digit</field>
                          </block>
                        </value>
                        <value name="DIVISOR">
                          <block type="math_number" id="num_mod_2_c">
                            <field name="NUM">2</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="num_zero_c">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <!-- Purchase ODD and reset state -->
                  <block type="variables_set" id="reset_state_after_trade">
                    <field name="VAR">State</field>
                    <value name="VALUE">
                      <block type="math_number" id="num_val_0_b">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <block type="purchase" id="purchase_odd">
                        <field name="PURCHASE_LIST">DIGITODD</field>
                      </block>
                    </next>
                  </block>
                </statement>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <!-- Restart Block -->
  <block type="after_purchase" id="after_purchase_block" x="0" y="1300">
    <statement name="AFTERPURCHASE_STACK">
      <block type="trade_again" id="trade_again_action"></block>
    </statement>
  </block>
</xml>